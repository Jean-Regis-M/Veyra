# ==============================================================================
# VEYRA Deployment & Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Orchestration & Model Provider (OpenAI-Compatible)
# ------------------------------------------------------------------------------
MIDEND_AI_BASE_URL=https://api.llm7.io/v1
MIDEND_AI_API_KEY=your_api_key_here
MIDEND_AI_MODEL=default
MIDEND_AI_TIMEOUT=60.0

# ------------------------------------------------------------------------------
# 2. Service Endpoints & Networking
# ------------------------------------------------------------------------------
# URL for the deterministic backend service
VEYRA_BACKEND_URL=http://8.231.81.99:8000

# Connector for midend -> backend communication ("http" or "mcp")
MIDEND_BACKEND_CONNECTOR=http

# Next.js frontend exposure URLs
NEXT_PUBLIC_VEYRA_BACKEND_URL=http://8.231.81.99:8000
NEXT_PUBLIC_VEYRA_MIDEND_URL=http://8.231.81.99:8080

# Timeouts (seconds)
MIDEND_BACKEND_TIMEOUT=30.0
MIDEND_MCP_TIMEOUT=30.0

# ------------------------------------------------------------------------------
# 3. Path & Resource Configuration (Optional - Defaults are auto-discovered)
# ------------------------------------------------------------------------------
# Repository root path (default: auto-discovered relative to code location)
# VEYRA_ROOT=/opt/veyra

# Custom directory for data files (references, model_envs, resources)
# VEYRA_DATA_DIR=/opt/veyra/data

# Custom directory for SQLite cache files
# VEYRA_CACHE_DIR=/opt/veyra/backend/cache

# Custom base directory for reference genomes
# GENOME_REFERENCES_DIR=/srv/genomes/references

# Explicit paths to reference fasta files (optional overrides)
# ECOLI_FASTA_PATH=/opt/veyra/data/references/ecoli_k12/genome/GCF_000005845.2.fasta
# GRCH38_FASTA_PATH=/srv/genomes/GRCh38.p14_genomic.fna

# Explicit path to Cas-OFFinder binary (optional override)
# CAS_OFFINDER_BIN=/opt/veyra/data/tools/cas-offinder/build/cas-offinder
