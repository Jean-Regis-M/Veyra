# ===========================================
# VEYRA .gitignore
# ===========================================

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/

# ----- Virtual environments -----
venv/
.venv/
env/
.env

# ----- IDE -----
.vscode/
.idea/
*.swp
*.swo
*~

# ----- OS -----
.DS_Store
Thumbs.db
desktop.ini

# ----- SQLite caches -----
*.db
cache/veyra_cache.db

# ----- VEYRA backend -----
veyra/backend/.pytest_cache/
veyra/backend/**/__pycache__/

# ===========================================
# REFRENCES - Large files & binaries
# ===========================================

# --- Genome assemblies (3+ GB) ---
refrences/refs/ncbi_dataset/
refrences/refs/ncbi_dataset.zip
refrences/refs/*.fna
refrences/refs/*.fa

# --- BLAST databases (large binary) ---
refrences/refs/grch38_db.*

# --- Model checkpoints & datasets (500MB+) ---
refrences/data/models/*.ckpt
refrences/data/models/*.csv
refrences/data/models/*.pth
refrences/data/models/*.pt
refrences/data/models/*.bin

# --- Large benchmark data ---
refrences/data/benchmarks/**/*.zip
refrences/data/benchmarks/**/*.xlsx
refrences/data/benchmarks/**/*.sqlite
refrences/data/benchmarks/**/*.marshal

# --- External tool repos (have their own .git) ---
refrences/data/tools/changeseq/
refrences/data/tools/crisporWebsite/
refrences/data/tools/guideseq/

# --- Binary tools ---
refrences/bin/datasets

# --- Large FASTA files ---
refrences/data/tools/guideseq/test/chr19.fa

# --- Compressed archives ---
*.tar.gz
*.tar.bz2
*.gz

# ===========================================
# KEEP - Small config/reference files
# ===========================================
!refrences/refs/README.md
!refrences/refs/md5sum.txt
!refrences/refs/self_test.tsv
!refrences/data/models/cclmoff_files.json
!refrences/data/benchmark_unified/schema.txt
!refrences/data/tools/crisporWebsite/CFD_Scoring/*.pkl
/refrences.local/