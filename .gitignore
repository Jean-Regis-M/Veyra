# ===========================================
# VEYRA Project .gitignore
# ===========================================

# ----- OS files -----
.DS_Store
Thumbs.db
desktop.ini
*~
.Spotlight-V100
.Trashes

# ----- IDE / Editor -----
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ===========================================
# Python / VEYRA Backend
# ===========================================

__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
venv/
.venv/
env/
.env

# SQLite caches
*.db
!refrences/data/tools/crisporWebsite/screenData/*.sqlite

# Pytest
.pytest_cache/

# ===========================================
# Node.js / Next.js Frontend
# ===========================================

node_modules/
.next/
out/
build/

# npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===========================================
# REFRENCES - Large files & binaries
# ===========================================

# Large data directories (kept on disk, not in git)
/refrences/
/refrences.local/
veyra/refrences.local/

# ===========================================
# VEYRA Data - Test artifacts
# ===========================================

# BWA index files (regenerated)
*.bwt
*.pac
*.ann
*.amb
*.sa

# samtools index
*.fai

# Temporary files
*.tmp
*.temp

# Cas-OFFinder build artifacts
veyra/data/tools/cas-offinder/

# Model runtime environments (provisioned at runtime)
veyra/data/model_envs/
backend/cache/model_runtime/

.impeccable/
.claude/

veyra/cache/
veyra/mcp/
veyra/backend/cache/model_runtime/
